{"scoreOn":true,"movesOn":true,"start":2,"localBase":17,"title":"L'Orbe de Sortis","adventureVersion":"","stats":[{"name":"VIE","init":20,"min":0,"max":20,"hidden":false},{"name":"FORCE","init":7,"min":0,"max":15,"hidden":false},{"name":"MAGIE","init":2,"min":0,"max":12,"hidden":false},{"name":"OR","init":15,"min":0,"max":99,"hidden":false}],"items":[{"label":"DAGUE","defaultOn":true,"atk":0,"dmg":0,"armor":0},{"label":"ÉPÉE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"BOUCLIER","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"TORCHE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"LANTERNE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"CORDE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"CLÉ ROUILLÉE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"CLÉ D'ARGENT","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"POTION DE SOIN","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"POTION DE FORCE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"GRIMOIRE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"GEMME BLEUE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"AMULETTE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"PROVISIONS","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"ANNEAU MAGIQUE","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"FIOLE DE POISON","defaultOn":false,"atk":0,"dmg":0,"armor":0},{"label":"ORBE DE SORTIS","defaultOn":false,"atk":0,"dmg":0,"armor":0}],"flags":[{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false},{"defaultOn":false}],"introIndex":[0,1],"combatAttackIndex":255,"combatHpIndex":255,"combatBaseDmg":2,"uiStrings":["Nouvelle partie","Continuer","QUITTER","Inventaire","I=INV S=SAUVE L=CHARGE Q=MENU","Continuer","Continuer","Victoire !","Défaite","Fin","Partie sauvegardée.","Échec de la sauvegarde.","Aucune sauvegarde trouvée.","Inventaire","Inventaire vide","Aucune issue possible","Erreur de chargement de la section","Revenir au menu ?","Sauvegarder et revenir","Revenir sans sauvegarder","Annuler","Chargement","Sauvegarde","Score","Mvt","Att","Dég","Arm","PV","Dés","Vous","Parade","Attaquer","Fuir","OPTIONS","OPTIONS SON","SORTIE","HAUT-PARLEUR","MOCKINGBOARD","SLOT","MOCKINGBOARD (NO DE SLOT)","MOCKINGBOARD NON COMPILÉE","TESTER LES SONS","Retour","TEST DES SONS","TOUT JOUER","INFO SYSTEME","INFO SYSTEME"],"sections":[{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Depuis mille ans, la malédiction de l'archimage Malgarde pèse sur la contrée de Mornegarde. On dit qu'au fond de son donjon repose l'Orbe de Sortis, seule capable de briser le sort. Nul n'en est jamais revenu... jusqu'à vous."}],"choices":[],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":3,"text":"VOTRE QUÊTE"},{"cond":{"clauses":[]},"style":0,"text":"En haut de l'écran :"},{"cond":{"clauses":[]},"style":0,"text":"\u0001VIE\u0001 : vos points de vie. À zéro, la quête s'achève. \u0001FORCE\u0001 : bousculer, enfoncer, affronter. Certains passages l'exigent. \u0001MAGIE\u0001 : sentir les pièges, tirer parti d'une amulette ou d'un grimoire. \u0001OR\u0001 : votre bourse."},{"cond":{"clauses":[]},"style":0,"text":"Vous n'avez qu'une dague. Ramasser des objets, boire une potion, choisir la ruse ou la force : tout compte. Touchez I pour ouvrir votre sac."},{"cond":{"clauses":[]},"style":0,"text":"Rapportez l'Orbe de Sortis, ou restez au fond du donjon."}],"choices":[],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Le vent d'automne pousse les feuilles mortes dans les ruelles de Mornegarde. On raconte que l'archimage Malgarde garde, au fond de son donjon, l'Orbe de Sortis : celui qui la rapportera délivrera la contrée de sa malédiction. Vous n'avez qu'une dague, quelques pièces, et beaucoup de courage."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":3,"label":"Gagner la place du village"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La place est le cœur de Mornegarde : la taverne du Sanglier fume à votre gauche, l'échoppe du marchand s'ouvre à droite, et la grande porte mène au monde sauvage."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":5,"label":"Entrer à la taverne"},{"cond":{"clauses":[]},"effects":[],"target":8,"label":"Visiter l'échoppe du marchand"},{"cond":{"clauses":[[{"op":3,"a0":8,"a1":0,"a2":0}]]},"effects":[],"target":4,"label":"Boire une potion de soin"},{"cond":{"clauses":[]},"effects":[],"target":9,"label":"Se diriger vers la grande porte"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":20,"a0":8,"a1":0,"a2":0},{"guard":{"clauses":[]},"op":21,"a0":0,"a1":8,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Vous videz la fiole tiède. Une chaleur bienfaisante recoud vos blessures."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":3,"label":"Continuer"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La salle sent la bière et la tourbe. Un vieux barde borgne vous fixe depuis un coin sombre. Le tavernier astique un pichet."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":6,"label":"Aborder le vieux barde"},{"cond":{"clauses":[[{"op":2,"a0":1,"a1":0,"a2":0}]]},"effects":[],"target":7,"label":"Boire une chope (1 or)"},{"cond":{"clauses":[]},"effects":[],"target":3,"label":"Ressortir sur la place"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":16,"a0":0,"a1":0,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":12,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"« L'Orbe ? » souffle le borgne. « Malgarde la protège d'une barrière de sortilège. Sans magie ni grimoire, tu n'iras nulle part. Et méfie-toi de son geôlier... » Il vous glisse une vieille amulette avant de disparaître."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":3,"label":"Le remercier et sortir"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":16,"a0":1,"a1":0,"a2":0},{"guard":{"clauses":[]},"op":22,"a0":3,"a1":1,"a2":0},{"guard":{"clauses":[]},"op":21,"a0":0,"a1":1,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La chope vous réchauffe et deux ivrognes vous confient un raccourci par la forêt. Vous vous sentez d'attaque."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":5,"label":"Retourner dans la salle"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"« Bienvenue, aventurier ! » lance le marchand. « De la bonne came, pas chère. » Vous avez de quoi choisir, si votre bourse suit."}],"choices":[{"cond":{"clauses":[[{"op":5,"a0":3,"a1":5,"a2":10},{"op":4,"a0":1,"a1":0,"a2":0}]]},"effects":[{"guard":{"clauses":[]},"op":22,"a0":3,"a1":10,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":1,"a1":0,"a2":0}],"target":8,"label":"Acheter une épée (10 or)"},{"cond":{"clauses":[[{"op":5,"a0":3,"a1":5,"a2":6},{"op":4,"a0":2,"a1":0,"a2":0}]]},"effects":[{"guard":{"clauses":[]},"op":22,"a0":3,"a1":6,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":2,"a1":0,"a2":0}],"target":8,"label":"Acheter un bouclier (6 or)"},{"cond":{"clauses":[[{"op":5,"a0":3,"a1":5,"a2":3},{"op":4,"a0":3,"a1":0,"a2":0}]]},"effects":[{"guard":{"clauses":[]},"op":22,"a0":3,"a1":3,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":3,"a1":0,"a2":0}],"target":8,"label":"Acheter une torche (3 or)"},{"cond":{"clauses":[[{"op":5,"a0":3,"a1":5,"a2":2},{"op":4,"a0":5,"a1":0,"a2":0}]]},"effects":[{"guard":{"clauses":[]},"op":22,"a0":3,"a1":2,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":5,"a1":0,"a2":0}],"target":8,"label":"Acheter une corde (2 or)"},{"cond":{"clauses":[[{"op":5,"a0":3,"a1":5,"a2":5},{"op":4,"a0":8,"a1":0,"a2":0}]]},"effects":[{"guard":{"clauses":[]},"op":22,"a0":3,"a1":5,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":8,"a1":0,"a2":0}],"target":8,"label":"Acheter une potion de soin (5 or)"},{"cond":{"clauses":[[{"op":5,"a0":3,"a1":5,"a2":4},{"op":4,"a0":13,"a1":0,"a2":0}]]},"effects":[{"guard":{"clauses":[]},"op":22,"a0":3,"a1":4,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":13,"a1":0,"a2":0}],"target":8,"label":"Acheter des provisions (4 or)"},{"cond":{"clauses":[]},"effects":[],"target":3,"label":"Quitter l'échoppe"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Le garde de la porte croise sa hallebarde. « Péage : deux pièces pour sortir en armes. » Derrière lui, un panneau rongé indique deux directions : la forêt noire, ou les monts brumeux."}],"choices":[{"cond":{"clauses":[[{"op":5,"a0":3,"a1":5,"a2":2}]]},"effects":[],"target":10,"label":"Payer le péage (2 or)"},{"cond":{"clauses":[[{"op":5,"a0":1,"a1":5,"a2":7}]]},"effects":[],"target":11,"label":"Bousculer le garde et forcer le passage"},{"cond":{"clauses":[]},"effects":[],"target":3,"label":"Renoncer et rester au village"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":22,"a0":3,"a1":2,"a2":0},{"guard":{"clauses":[]},"op":16,"a0":2,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Le garde empoche vos pièces et s'écarte. « Bonne route, et bonne chance. »"}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":12,"label":"Prendre la route de la forêt noire"},{"cond":{"clauses":[]},"effects":[],"target":26,"label":"Prendre la route des monts brumeux"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":22,"a0":0,"a1":1,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"D'un coup d'épaule vous renversez le garde ahuri et filez avant que l'alarme ne sonne. On se souviendra de vous à Mornegarde."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":12,"label":"Prendre la route de la forêt noire"},{"cond":{"clauses":[]},"effects":[],"target":26,"label":"Prendre la route des monts brumeux"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":16,"a0":3,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Sous les frondaisons, la lumière se fait rare. Un sentier serpente vers une clairière ; un autre plonge vers le bruit d'une rivière."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":13,"label":"Gagner la clairière"},{"cond":{"clauses":[]},"effects":[],"target":18,"label":"Descendre vers la rivière"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Au centre de la clairière, une cabane biscornue laisse échapper une fumée verte. Sur une souche, quelqu'un a oublié une corde et un quignon de pain."}],"choices":[{"cond":{"clauses":[[{"op":4,"a0":5,"a1":0,"a2":0}]]},"effects":[],"target":14,"label":"Ramasser la corde et le pain"},{"cond":{"clauses":[]},"effects":[],"target":15,"label":"Frapper à la porte de la cabane"},{"cond":{"clauses":[]},"effects":[],"target":18,"label":"Repartir vers la rivière"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":19,"a0":5,"a1":0,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":13,"a1":0,"a2":0},{"guard":{"clauses":[]},"op":25,"a0":4,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Vous empochez la corde et les provisions."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":13,"label":"Observer la cabane"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Une vieille sorcière aux yeux de chat vous jauge. « Tu vas chez Malgarde ? Rends-moi service et je t'enseignerai un sortilège. Apporte-moi une gemme bleue... ou bien pars, si tu l'as déjà. »"}],"choices":[{"cond":{"clauses":[[{"op":3,"a0":11,"a1":0,"a2":0}]]},"effects":[],"target":16,"label":"Offrir la gemme bleue"},{"cond":{"clauses":[[{"op":4,"a0":11,"a1":0,"a2":0}]]},"effects":[],"target":13,"label":"Promettre de revenir avec la gemme"},{"cond":{"clauses":[]},"effects":[],"target":17,"label":"Refuser et sortir"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":20,"a0":11,"a1":0,"a2":0},{"guard":{"clauses":[]},"op":16,"a0":6,"a1":0,"a2":0},{"guard":{"clauses":[]},"op":16,"a0":7,"a1":0,"a2":0},{"guard":{"clauses":[]},"op":21,"a0":2,"a1":4,"a2":0},{"guard":{"clauses":[]},"op":19,"a0":15,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La sorcière sourit et grave dans votre esprit les mots d'un sortilège de lumière. « La barrière de Malgarde ne te résistera plus. » Elle vous donne aussi une fiole de poison, « pour les mauvaises rencontres »."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":13,"label":"La remercier"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"« Comme tu voudras, têtu. » La porte claque. Le vent s'est levé."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":18,"label":"Descendre vers la rivière"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La rivière gronde, trop large pour un saut. Un tronc glissant en travers pourrait servir de pont... si vous aviez de quoi vous assurer. Sur l'autre rive, la forêt s'ouvre vers de vieilles ruines."}],"choices":[{"cond":{"clauses":[[{"op":3,"a0":5,"a1":0,"a2":0}]]},"effects":[],"target":19,"label":"Franchir en s'assurant avec la corde"},{"cond":{"clauses":[]},"effects":[],"target":20,"label":"Tenter la traversée sur le tronc nu"},{"cond":{"clauses":[]},"effects":[],"target":13,"label":"Remonter vers la clairière"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":16,"a0":8,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La corde tendue, vous traversez sans encombre le courant glacé."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":21,"label":"Atteindre les ruines"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":22,"a0":0,"a1":6,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Le tronc est traître. Vous glissez, la rivière vous emporte et vous martèle contre les rochers avant que vous ne vous échouiez, hagard, sur l'autre rive."}],"choices":[{"cond":{"clauses":[[{"op":5,"a0":0,"a1":5,"a2":1}]]},"effects":[],"target":21,"label":"Ramper jusqu'aux ruines"},{"cond":{"clauses":[[{"op":5,"a0":0,"a1":3,"a2":0}]]},"effects":[],"target":76,"label":"..."}],"chapte