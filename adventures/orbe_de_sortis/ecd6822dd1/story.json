0":0,"a1":3,"a2":0}]]},"effects":[],"target":83,"label":"..."}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":22,"a0":0,"a1":10,"a2":0},{"guard":{"clauses":[]},"op":16,"a0":16,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Vous vous ruez, lame en avant. La foudre vous cueille de plein fouet mais votre épée entaille l'archimage, qui recule en saignant."}],"choices":[{"cond":{"clauses":[[{"op":5,"a0":0,"a1":5,"a2":1}]]},"effects":[],"target":70,"label":"Porter le coup final"},{"cond":{"clauses":[[{"op":5,"a0":0,"a1":3,"a2":0}]]},"effects":[],"target":83,"label":"..."}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":22,"a0":0,"a1":14,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Contre un archimage, une dague est dérisoire. Sa foudre vous fauche avant même que vous n'ayez atteint l'escalier."}],"choices":[{"cond":{"clauses":[[{"op":5,"a0":0,"a1":5,"a2":1},{"op":1,"a0":16,"a1":0,"a2":0}]]},"effects":[],"target":70,"label":"Frapper malgré tout"},{"cond":{"clauses":[]},"effects":[],"target":83,"label":"..."}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":16,"a0":16,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Dans un dernier éclat, Malgarde s'effondre au pied de l'autel. L'Orbe de Sortis brille, libre, à portée de main."}],"choices":[{"cond":{"clauses":[]},"effects":[],"target":71,"label":"Saisir l'Orbe de Sortis"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[{"guard":{"clauses":[]},"op":19,"a0":16,"a1":0,"a2":0}],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Vos doigts se referment sur l'Orbe tiède. Un soupir de soulagement semble parcourir toute la contrée. Mais la tour tremble : Malgarde mort, son donjon s'effondre."}],"choices":[{"cond":{"clauses":[[{"op":1,"a0":12,"a1":0,"a2":0}]]},"effects":[],"target":73,"label":"Fuir avec l'apprenti qui connaît les issues"},{"cond":{"clauses":[]},"effects":[],"target":72,"label":"Fuir par où vous êtes venu"}],"chapter":0},{"mode":0,"ending":0,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Vous dévalez les escaliers tandis que les voûtes s'écroulent. Poussière et gravats vous mordent les talons."}],"choices":[{"cond":{"clauses":[[{"op":5,"a0":0,"a1":5,"a2":6}]]},"effects":[],"target":74,"label":"Foncer sans regarder en arrière"},{"cond":{"clauses":[[{"op":3,"a0":14,"a1":0,"a2":0}]]},"effects":[],"target":74,"label":"Vous envelopper de l'anneau magique et passer"},{"cond":{"clauses":[]},"effects":[],"target":75,"label":"Vous frayer un chemin en toussant"}],"chapter":0},{"mode":0,"ending":1,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Guidé par l'apprenti, vous jaillissez à l'air libre au moment où la tour s'abat. L'Orbe de Sortis lève la malédiction : Mornegarde vous acclame en héros, et les ménestrels chanteront longtemps votre nom."}],"choices":[],"chapter":0},{"mode":0,"ending":1,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Vous surgissez du donjon en ruines, l'Orbe serrée contre vous. La contrée est sauvée. Vous rentrez à Mornegarde, fourbu mais glorieux."}],"choices":[],"chapter":0},{"mode":0,"ending":1,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Vous rampez hors des décombres, à demi asphyxié, l'Orbe intacte. La victoire a un goût de cendre, mais la malédiction est brisée. C'est l'essentiel."}],"choices":[],"chapter":0},{"mode":0,"ending":2,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La rivière ne vous a pas rendu. Votre quête s'achève, emportée par le courant."}],"choices":[],"chapter":0},{"mode":0,"ending":2,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Le loup gris a eu raison de vous parmi les ruines silencieuses. Nul ne saura."}],"choices":[],"chapter":0},{"mode":0,"ending":2,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La massue du troll vous a brisé. Votre aventure s'arrête dans la grotte obscure."}],"choices":[],"chapter":0},{"mode":0,"ending":2,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Le pont a cédé. Le gouffre brumeux vous a englouti sans un bruit."}],"choices":[],"chapter":0},{"mode":0,"ending":2,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Le geôlier de Malgarde se dresse, victorieux, au-dessus de votre corps."}],"choices":[],"chapter":0},{"mode":0,"ending":2,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"Les lames de la salle piégée ont eu le dernier mot. Vous ne verrez jamais l'Orbe."}],"choices":[],"chapter":0},{"mode":0,"ending":2,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La barrière de sortilège vous a consumé. De vous, il ne reste qu'une ombre sur les dalles."}],"choices":[],"chapter":0},{"mode":0,"ending":2,"image":65535,"splash":null,"combat":null,"input":null,"onEnter":[],"onExit":[],"texts":[{"cond":{"clauses":[]},"style":0,"text":"La foudre de Malgarde a fait de vous un tas de cendres. L'Orbe demeure sie